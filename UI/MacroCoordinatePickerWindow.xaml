<Window
  x:Class="Automatization.UI.MacroCoordinatePickerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  AllowsTransparency="True"
  Background="#30000000"
  Cursor="Cross"
  KeyDown="Window_KeyDown"
  MouseLeftButtonDown="Window_MouseLeftButtonDown"
  MouseMove="Window_MouseMove"
  MouseRightButtonDown="Window_MouseRightButtonDown"
  Topmost="True"
  WindowState="Maximized"
  WindowStyle="None"
>
  <Canvas x:Name="OverlayCanvas">
    <Border
      Canvas.Left="0"
      Canvas.Top="25"
      Padding="20,10"
      HorizontalAlignment="Center"
      Background="#E8181825"
      BorderBrush="#50FFFFFF"
      BorderThickness="1"
      CornerRadius="8"
    >
      <StackPanel HorizontalAlignment="Center">
        <TextBlock
          FontSize="15"
          FontWeight="SemiBold"
          Foreground="White"
          Text="Click anywhere to capture Coordinates &amp; Pixel Color"
          TextAlignment="Center"
        />
        <TextBlock
          Margin="0,4,0,0"
          FontSize="12"
          Foreground="#B0FFFFFF"
          Text="Move cursor to preview color • Press ESC or Right-Click to Cancel"
          TextAlignment="Center"
        />
      </StackPanel>
    </Border>

    <Border
      x:Name="HudBorder"
      Padding="8,6"
      Background="#EA11111B"
      BorderBrush="#60FFFFFF"
      BorderThickness="1"
      CornerRadius="6"
      IsHitTestVisible="False"
      Visibility="Collapsed"
    >
      <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
        <Border
          x:Name="ColorSwatch"
          Width="20"
          Height="20"
          Margin="0,0,8,0"
          Background="White"
          BorderBrush="#80FFFFFF"
          BorderThickness="1"
          CornerRadius="3"
        />
        <StackPanel>
          <TextBlock
            x:Name="TxtHudCoords"
            FontSize="11"
            FontWeight="Bold"
            Foreground="White"
            Text="X: 0, Y: 0"
          />
          <TextBlock
            x:Name="TxtHudColor"
            FontFamily="Consolas"
            FontSize="10"
            Foreground="#A6ADC8"
            Text="#FFFFFF"
          />
        </StackPanel>
      </StackPanel>
    </Border>
  </Canvas>
</Window>
