<ui:FluentWindow
  x:Class="Automatization.UI.MacroDocsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="AutoScript Reference &amp; Macro Documentation"
  Width="880"
  Height="680"
  MinWidth="700"
  MinHeight="500"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="AutoScript Reference &amp; Guide" Grid.Row="0" />

    <Border
      Grid.Row="1"
      Margin="15,5,15,10"
      Padding="14,10"
      Background="#12FFFFFF"
      BorderBrush="#25FFFFFF"
      BorderThickness="1"
      CornerRadius="8"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock
              FontSize="16"
              FontWeight="SemiBold"
              Foreground="#40C4FF"
              Text="AutoScript Language Documentation"
            />
            <TextBlock
              Margin="0,2,0,0"
              FontSize="12"
              Foreground="#90FFFFFF"
              Text="Comprehensive guide for building macros via Code or Visual Builder (.azmacro)"
            />
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
            <ui:Button
              x:Name="CopyDocsButton"
              Height="30"
              Padding="10,0"
              Appearance="Secondary"
              Click="CopyDocsButton_Click"
              Content="Copy All"
              Icon="{ui:SymbolIcon Copy24}"
              ToolTip="Copy full documentation text to clipboard"
            />
          </StackPanel>
        </Grid>

        <FlowDocumentScrollViewer
          x:Name="DocsViewer"
          Grid.Row="1"
          Background="#14141E"
          BorderBrush="#25FFFFFF"
          BorderThickness="1"
          Foreground="#E0E0E0"
          HorizontalScrollBarVisibility="Auto"
          IsSelectionEnabled="True"
          VerticalScrollBarVisibility="Auto"
        />
      </Grid>
    </Border>

    <Border
      Grid.Row="2"
      Padding="15,10"
      Background="#0AFFFFFF"
      BorderBrush="#18FFFFFF"
      BorderThickness="0,1,0,0"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          FontSize="12"
          Foreground="#70FFFFFF"
          Text="Tip: You can switch between Visual Builder and Code at any time using Visual -> Code and Code -> Visual buttons."
        />

        <ui:Button
          Grid.Column="1"
          Width="90"
          Height="32"
          Appearance="Primary"
          Click="CloseButton_Click"
          Content="Close"
        />
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
