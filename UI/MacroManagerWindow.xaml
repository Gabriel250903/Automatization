<ui:FluentWindow
  x:Class="Automatization.UI.MacroManagerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Automatization.Controls"
  xmlns:converters="clr-namespace:Automatization.Converters"
  xmlns:core="clr-namespace:Automatization.Macros.Core"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="clr-namespace:Automatization.Macros.Models"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Macro Manager"
  Width="1050"
  Height="720"
  MinWidth="1050"
  MinHeight="720"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner"
  mc:Ignorable="d"
>
  <ui:FluentWindow.Resources>
    <converters:HexToSolidColorBrushConverter x:Key="HexToBrushConverter" />
    <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type controls:HotKeyBox}">
      <Setter Property="Height" Value="34" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="ToolTip" Value="Click to edit. Press Backspace or Delete to unbind." />

      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter
            Property="BorderBrush"
            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
          />
        </Trigger>

        <Trigger Property="IsFocused" Value="True">
          <Setter Property="FontWeight" Value="Bold" />
          <Setter
            Property="Foreground"
            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
          />
          <Setter
            Property="BorderBrush"
            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
          />
        </Trigger>
      </Style.Triggers>
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="Macro Manager" Grid.Row="0" />

    <Grid Grid.Row="1" Margin="15,5,15,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MinWidth="300" MaxWidth="500" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="480" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Grid.Column="0"
              VerticalAlignment="Center"
              FontSize="18"
              FontWeight="SemiBold"
              Text="Macros"
            />
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
              <ui:Button
                x:Name="AddMacroButton"
                Height="30"
                Padding="8,0"
                Appearance="Primary"
                Click="AddMacroButton_Click"
                Content="New"
                Icon="{ui:SymbolIcon Add24}"
                ToolTip="Create a new macro"
              />
              <ui:Button
                x:Name="ImportMacroButton"
                Height="30"
                Margin="4,0,0,0"
                Padding="8,0"
                Appearance="Secondary"
                Click="ImportMacroButton_Click"
                Icon="{ui:SymbolIcon ArrowImport24}"
                ToolTip="Import macro from file (.azmacro)"
              />
              <ui:Button
                x:Name="ExportMacroButton"
                Height="30"
                Margin="4,0,0,0"
                Padding="8,0"
                Appearance="Secondary"
                Click="ExportMacroButton_Click"
                Icon="{ui:SymbolIcon Share24}"
                ToolTip="Export selected macro to file (.azmacro)"
              />
              <ui:Button
                x:Name="DuplicateMacroButton"
                Height="30"
                Margin="4,0,0,0"
                Padding="8,0"
                Appearance="Secondary"
                Click="DuplicateMacroButton_Click"
                Icon="{ui:SymbolIcon Copy24}"
                ToolTip="Duplicate selected macro"
              />
              <ui:Button
                x:Name="DeleteMacroButton"
                Height="30"
                Margin="4,0,0,0"
                Padding="8,0"
                Appearance="Danger"
                Click="DeleteMacroButton_Click"
                Icon="{ui:SymbolIcon Delete24}"
                ToolTip="Delete selected macro"
              />
            </StackPanel>
          </Grid>

          <ui:TextBox
            x:Name="TxtSearchMacro"
            Height="32"
            Icon="{ui:SymbolIcon Search24}"
            PlaceholderText="Search macros (name, hotkey)..."
            TextChanged="TxtSearchMacro_TextChanged"
          />
        </StackPanel>

        <ListView
          x:Name="MacroListView"
          Grid.Row="1"
          Padding="0,2,2,2"
          Background="Transparent"
          BorderThickness="0"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          SelectionChanged="MacroListView_SelectionChanged"
          SelectionMode="Single"
        >
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,2,0,4" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListViewItem">
                    <Border
                      x:Name="ItemCard"
                      Padding="10,9"
                      Background="#0CFFFFFF"
                      BorderBrush="#18FFFFFF"
                      BorderThickness="1"
                      CornerRadius="8"
                      SnapsToDevicePixels="True"
                    >
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ItemCard" Property="Background" Value="#18FFFFFF" />
                        <Setter TargetName="ItemCard" Property="BorderBrush" Value="#2EFFFFFF" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemCard" Property="Background" Value="#2240C4FF" />
                        <Setter TargetName="ItemCard" Property="BorderBrush" Value="#5540C4FF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate DataType="{x:Type models:MacroDefinition}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                  Grid.Column="0"
                  Width="3"
                  Height="28"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  CornerRadius="1.5"
                >
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#30FFFFFF" />
                      <Style.Triggers>
                        <DataTrigger
                          Binding="{Binding State}"
                          Value="{x:Static core:MacroExecutionState.Running}"
                        >
                          <Setter Property="Background" Value="#00E676" />
                          <Setter Property="Effect">
                            <Setter.Value>
                              <DropShadowEffect
                                BlurRadius="6"
                                Opacity="0.8"
                                ShadowDepth="0"
                                Color="#00E676"
                              />
                            </Setter.Value>
                          </Setter>
                        </DataTrigger>
                        <DataTrigger
                          Binding="{Binding State}"
                          Value="{x:Static core:MacroExecutionState.Paused}"
                        >
                          <Setter Property="Background" Value="#FFA726" />
                        </DataTrigger>
                        <DataTrigger
                          Binding="{Binding State}"
                          Value="{x:Static core:MacroExecutionState.Error}"
                        >
                          <Setter Property="Background" Value="#EF5350" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                      Grid.Column="0"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis"
                    >
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#FFFFFF" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                              <Setter Property="Foreground" Value="#65FFFFFF" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>

                    <Border
                      Grid.Column="1"
                      Margin="6,0,0,0"
                      Padding="5,1"
                      VerticalAlignment="Center"
                      Background="#2500E676"
                      BorderBrush="#6000E676"
                      BorderThickness="1"
                      CornerRadius="3"
                    >
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger
                              Binding="{Binding State}"
                              Value="{x:Static core:MacroExecutionState.Running}"
                            >
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="#00E676"
                        Text="RUNNING"
                      />
                    </Border>
                  </Grid>

                  <WrapPanel Margin="0,5,0,0">
                    <Border
                      Margin="0,0,5,0"
                      Padding="5,1.5"
                      Background="#22000000"
                      BorderBrush="#30FFFFFF"
                      BorderThickness="1"
                      CornerRadius="4"
                      ToolTip="Trigger Keybind"
                    >
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                          Margin="0,0,4,0"
                          VerticalAlignment="Center"
                          FontSize="10"
                          Foreground="#40C4FF"
                          Symbol="Keyboard24"
                        />
                        <TextBlock
                          VerticalAlignment="Center"
                          FontFamily="Consolas, Cascadia Code, Segoe UI"
                          FontSize="10"
                          FontWeight="SemiBold"
                          Foreground="#FFFFFF"
                          Text="{Binding TriggerHotKey}"
                        />
                      </StackPanel>
                    </Border>

                    <Border
                      Margin="0,0,5,0"
                      Padding="5,1.5"
                      Background="#1440C4FF"
                      BorderBrush="#2540C4FF"
                      BorderThickness="1"
                      CornerRadius="4"
                      ToolTip="Target Scope"
                    >
                      <TextBlock
                        VerticalAlignment="Center"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="#80D8FF"
                        Text="{Binding TargetMode}"
                      />
                    </Border>

                    <Border
                      Padding="5,1.5"
                      Background="#14FFFFFF"
                      BorderBrush="#20FFFFFF"
                      BorderThickness="1"
                      CornerRadius="4"
                      ToolTip="Run Mode"
                    >
                      <TextBlock
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="#B0FFFFFF"
                        Text="{Binding TriggerMode}"
                      />
                    </Border>
                  </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                  <CheckBox
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                    ToolTip="Enable / disable macro trigger hotkey"
                  />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>

      <GridSplitter
        Grid.Column="1"
        Width="6"
        HorizontalAlignment="Center"
        VerticalAlignment="Stretch"
        Background="Transparent"
        Cursor="SizeWE"
        ShowsPreview="False"
      />

      <Grid x:Name="EditorPanel" Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
          Grid.Row="0"
          Margin="0,0,0,10"
          Padding="16,14"
          HorizontalAlignment="Stretch"
          Background="#14FFFFFF"
          BorderBrush="#25FFFFFF"
          BorderThickness="1"
          CornerRadius="8"
        >
          <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.5*" MinWidth="180" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="1.1*" MinWidth="160" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="1.1*" MinWidth="175" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
              <TextBlock
                Margin="0,0,0,5"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#B0FFFFFF"
                Text="Macro Name"
              />
              <ui:TextBox
                x:Name="TxtMacroName"
                Height="34"
                HorizontalAlignment="Stretch"
                PlaceholderText="Enter macro name..."
              />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2">
              <Grid Margin="0,0,0,5">
                <TextBlock
                  FontSize="11"
                  FontWeight="SemiBold"
                  Foreground="#B0FFFFFF"
                  Text="Trigger Hotkey"
                />
                <StackPanel
                  x:Name="PnlHotkeyConflict"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal"
                  Visibility="Collapsed"
                >
                  <ui:SymbolIcon
                    Margin="0,0,3,0"
                    FontSize="11"
                    Foreground="#FF5252"
                    Symbol="Shield24"
                  />
                  <TextBlock
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="#FF5252"
                    Text="Conflict!"
                  />
                </StackPanel>
              </Grid>
              <controls:HotKeyBox
                x:Name="HotkeyBoxTrigger"
                Height="34"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
              />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="4">
              <TextBlock
                Margin="0,0,0,5"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#B0FFFFFF"
                Text="Run Mode"
              />
              <ComboBox x:Name="CmbTriggerMode" Height="37" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
              <TextBlock
                Margin="0,0,0,5"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#B0FFFFFF"
                Text="Description"
              />
              <ui:TextBox
                x:Name="TxtMacroDescription"
                Height="34"
                HorizontalAlignment="Stretch"
                PlaceholderText="Enter macro description (optional)..."
              />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
              <TextBlock
                Margin="0,0,0,5"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#B0FFFFFF"
                Text="Target Scope"
              />
              <ComboBox x:Name="CmbTargetMode" Height="34" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,10,0,0">
              <TextBlock
                Margin="0,0,0,5"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#B0FFFFFF"
                Text="Options"
              />
              <Grid Height="34" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                  x:Name="PnlDuration"
                  Grid.Column="0"
                  Margin="0,0,8,0"
                  Padding="6,2"
                  VerticalAlignment="Center"
                  Background="#14FFFFFF"
                  BorderBrush="#25FFFFFF"
                  BorderThickness="1"
                  CornerRadius="6"
                  Visibility="Collapsed"
                >
                  <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:SymbolIcon
                      Margin="0,0,4,0"
                      VerticalAlignment="Center"
                      FontSize="12"
                      Foreground="#40C4FF"
                      Symbol="Timer24"
                    />
                    <ui:TextBox
                      x:Name="TxtDurationSeconds"
                      Width="52"
                      Height="26"
                      Padding="4,2"
                      VerticalContentAlignment="Center"
                      PlaceholderText="10.0"
                      ToolTip="Run duration in seconds before stopping"
                    />
                    <TextBlock
                      Margin="4,0,2,0"
                      VerticalAlignment="Center"
                      FontSize="11"
                      FontWeight="SemiBold"
                      Foreground="#B0FFFFFF"
                      Text="s"
                    />
                  </StackPanel>
                </Border>

                <CheckBox
                  x:Name="ChkHumanize"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Content="Humanize"
                  ToolTip="Adds +/- 10% natural random jitter to delays to prevent bot detection"
                />
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <TabControl
          x:Name="EditorTabControl"
          Grid.Row="1"
          SelectionChanged="EditorTabControl_SelectionChanged"
        >
          <TabItem Header="Visual Builder">
            <Grid Margin="5">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="6"
                Background="#20FFFFFF"
                CornerRadius="6"
              >
                <WrapPanel>
                  <ui:Button
                    Margin="0,0,5,0"
                    Click="AddKeyPressAction_Click"
                    Content="Key Press"
                    Icon="{ui:SymbolIcon Keyboard24}"
                  />
                  <ui:Button
                    Margin="0,0,5,0"
                    Click="AddDelayAction_Click"
                    Content="Delay"
                    Icon="{ui:SymbolIcon Timer24}"
                  />
                  <ui:Button
                    Margin="0,0,5,0"
                    Click="AddMouseClickAction_Click"
                    Content="Click"
                    Icon="{ui:SymbolIcon Cursor24}"
                  />
                  <ui:Button
                    Margin="0,0,5,0"
                    Click="AddPixelCheckAction_Click"
                    Content="Check Pixel"
                    Icon="{ui:SymbolIcon Eye24}"
                  />
                  <ui:Button
                    Margin="0,0,5,0"
                    Click="AddLoopAction_Click"
                    Content="Loop"
                    Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                  />
                  <ui:Button
                    Margin="6,0,0,0"
                    Appearance="Secondary"
                    Click="PickCoordinatesAndColor_Click"
                    Content="Pick Point/Color"
                    Icon="{ui:SymbolIcon TargetArrow24}"
                  />
                </WrapPanel>
              </Border>

              <Grid Grid.Row="1">
                <TextBlock
                  x:Name="TxtEmptyVisualActions"
                  Margin="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="13"
                  FontStyle="Italic"
                  Foreground="#70FFFFFF"
                  Text="No visual actions yet. Click a button above to add an action, or switch to the Code tab."
                  TextAlignment="Center"
                  TextWrapping="Wrap"
                />

                <ScrollViewer Padding="0,0,6,0" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="VisualActionsItemsControl">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type models:MacroAction}">
                        <Border
                          Margin="0,0,0,8"
                          Padding="12,10"
                          BorderThickness="1"
                          CornerRadius="8"
                          SnapsToDevicePixels="True"
                        >
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="#12FFFFFF" />
                              <Setter Property="BorderBrush" Value="#22FFFFFF" />
                              <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Background" Value="#18FFFFFF" />
                                  <Setter Property="BorderBrush" Value="#38FFFFFF" />
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <Border
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="#2040C4FF"
                                BorderBrush="#4040C4FF"
                                BorderThickness="1"
                                CornerRadius="5"
                              >
                                <TextBlock
                                  FontSize="11"
                                  FontWeight="Bold"
                                  Foreground="#40C4FF"
                                  Text="{Binding Type}"
                                />
                              </Border>

                              <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#E8E8E8"
                                Text="{Binding DisplaySummary}"
                                TextTrimming="CharacterEllipsis"
                              />

                              <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                              >
                                <ui:Button
                                  Width="30"
                                  Height="28"
                                  Padding="0"
                                  Appearance="Secondary"
                                  Click="MoveActionUp_Click"
                                  Icon="{ui:SymbolIcon ArrowUp24}"
                                  Tag="{Binding}"
                                  ToolTip="Move Up"
                                />
                                <ui:Button
                                  Width="30"
                                  Height="28"
                                  Margin="4,0,0,0"
                                  Padding="0"
                                  Appearance="Secondary"
                                  Click="MoveActionDown_Click"
                                  Icon="{ui:SymbolIcon ArrowDown24}"
                                  Tag="{Binding}"
                                  ToolTip="Move Down"
                                />
                                <ui:Button
                                  Width="30"
                                  Height="28"
                                  Margin="6,0,0,0"
                                  Padding="0"
                                  Appearance="Danger"
                                  Click="DeleteAction_Click"
                                  Icon="{ui:SymbolIcon Delete24}"
                                  Tag="{Binding}"
                                  ToolTip="Delete Action"
                                />
                              </StackPanel>
                            </Grid>

                            <WrapPanel Grid.Row="1" Margin="0,9,0,0" VerticalAlignment="Center">
                              <StackPanel
                                Margin="0,3,14,3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsKeyAction, Converter={StaticResource BoolToVis}}"
                              >
                                <TextBlock
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="#A0FFFFFF"
                                  Text="Key:"
                                />
                                <ComboBox
                                  Width="150"
                                  Height="35"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CommonKeys}"
                                  MaxDropDownHeight="300"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding Key, Mode=TwoWay}"
                                  SelectionChanged="ActionParam_Changed"
                                />
                              </StackPanel>

                              <StackPanel
                                Margin="0,3,14,3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsHoldVisible, Converter={StaticResource BoolToVis}}"
                              >
                                <TextBlock
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="#A0FFFFFF"
                                  Text="Hold (ms):"
                                />
                                <TextBox
                                  Width="90"
                                  Height="35"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  Text="{Binding HoldMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  TextAlignment="Center"
                                  TextChanged="ActionParam_TextChanged"
                                />
                              </StackPanel>

                              <StackPanel
                                Margin="0,3,14,3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsDelayAction, Converter={StaticResource BoolToVis}}"
                              >
                                <TextBlock
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="#A0FFFFFF"
                                  Text="Delay (ms):"
                                />
                                <TextBox
                                  Width="95"
                                  Height="35"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  Text="{Binding DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  TextAlignment="Center"
                                  TextChanged="ActionParam_TextChanged"
                                />
                              </StackPanel>

                              <StackPanel
                                Margin="0,3,14,3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsDelayRangeAction, Converter={StaticResource BoolToVis}}"
                              >
                                <TextBlock
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="#A0FFFFFF"
                                  Text="Min (ms):"
                                />
                                <TextBox
                                  Width="80"
                                  Height="35"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  Text="{Binding MinDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  TextAlignment="Center"
                                  TextChanged="ActionParam_TextChanged"
                                />
                                <TextBlock
                                  Margin="10,0,6,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="#A0FFFFFF"
                                  Text="Max (ms):"
                                />
                                <TextBox
                                  Width="80"
                                  Height="35"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  Text="{Binding MaxDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  TextAlignment="Center"
                                  TextChanged="ActionParam_TextChanged"
                                />
                              </StackPanel>

                              <StackPanel
                                Margin="0,3,14,3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsMouseAction, Converter={StaticResource BoolToVis}}"
                              >
                                <TextBlock
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="#A0FFFFFF"
                                  Text="Button:"
                                />
                                <ComboBox
                                  Width="125"
                                  Height="35"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MouseButtons}"
                                  MaxDropDownHeight="300"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding MouseButton, Mode=TwoWay}"
                                  SelectionChanged="ActionParam_Changed"
                                />
                              </StackPanel>

                              <StackPanel
                                Margin="0,3,14,3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsCoordinatesVisible, Converter={StaticResource BoolToVis}}"
                              >
                                <TextBlock
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="#A0FFFFFF"
                                  Text="X:"
                                />
                                <TextBox
                                  Width="70"
                                  Height="35"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  TextAlignment="Center"
                                  TextChanged="ActionParam_TextChanged"
                                />
                                <TextBlock
                                  Margin="10,0,6,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="#A0FFFFFF"
                                  Text="Y:"
                                />
                                <TextBox
                                  Width="70"
                                  Height="35"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  TextAlignment="Center"
                                  TextChanged="ActionParam_TextChanged"
                                />
                                <ui:Button
                                  Height="35"
                                  Margin="8,0,0,0"
                                  Padding="10,0"
                                  Appearance="Secondary"
                                  Click="PickCardCoordinate_Click"
                                  Content="Pick"
                                  FontSize="13"
                                  Icon="{ui:SymbolIcon TargetArrow24}"
                                  Tag="{Binding}"
                                  ToolTip="Pick coordinates from screen"
                                />
                              </StackPanel>

                              <StackPanel
                                Margin="0,3,14,3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsColorVisible, Converter={StaticResource BoolToVis}}"
                              >
                                <TextBlock
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="#A0FFFFFF"
                                  Text="Color:"
                                />
                                <Border
                                  Width="26"
                                  Height="26"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                  BorderBrush="#55FFFFFF"
                                  BorderThickness="1.5"
                                  CornerRadius="4"
                                />
                                <TextBox
                                  Width="100"
                                  Height="35"
                                  VerticalContentAlignment="Center"
                                  FontFamily="Consolas, Cascadia Code, Courier New"
                                  FontSize="13"
                                  Text="{Binding ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  TextAlignment="Center"
                                  TextChanged="ActionParam_TextChanged"
                                />
                              </StackPanel>

                              <StackPanel
                                Margin="0,3,14,3"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsRepeatVisible, Converter={StaticResource BoolToVis}}"
                              >
                                <TextBlock
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="#A0FFFFFF"
                                  Text="Repeat:"
                                />
                                <TextBox
                                  Width="80"
                                  Height="35"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  Text="{Binding RepeatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  TextAlignment="Center"
                                  TextChanged="ActionParam_TextChanged"
                                />
                              </StackPanel>
                            </WrapPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Header="Script Code">
            <Grid Margin="5">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Border
                Grid.Row="0"
                Margin="0,0,0,8"
                Padding="8"
                Background="#14FFFFFF"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
              >
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <ui:Button
                      Height="32"
                      Margin="0,0,6,0"
                      Padding="10,0"
                      Appearance="Primary"
                      Click="CheckSyntaxButton_Click"
                      Content="Check Syntax"
                      FontWeight="SemiBold"
                      Icon="{ui:SymbolIcon CheckmarkCircle24}"
                      ToolTip="Compile and validate macro syntax"
                    />

                    <Border
                      Width="1"
                      Height="20"
                      Margin="4,0,8,0"
                      VerticalAlignment="Center"
                      Background="#28FFFFFF"
                    />

                    <ui:Button
                      Height="32"
                      Margin="0,0,5,0"
                      Padding="9,0"
                      Appearance="Secondary"
                      Click="SyncVisualToCode_Click"
                      Content="Visual -&gt; Code"
                      Icon="{ui:SymbolIcon Code24}"
                      ToolTip="Convert visual action blocks into script code"
                    />

                    <ui:Button
                      Height="32"
                      Margin="0,0,6,0"
                      Padding="9,0"
                      Appearance="Secondary"
                      Click="SyncCodeToVisual_Click"
                      Content="Code -&gt; Visual"
                      Icon="{ui:SymbolIcon AppsListDetail24}"
                      ToolTip="Decompile script code into visual action blocks"
                    />

                    <Border
                      Width="1"
                      Height="20"
                      Margin="4,0,8,0"
                      VerticalAlignment="Center"
                      Background="#28FFFFFF"
                    />

                    <ui:Button
                      Height="32"
                      Margin="0,0,4,0"
                      Padding="9,0"
                      Appearance="Secondary"
                      Click="PickCoordinatesAndColor_Click"
                      Content="Pick Point/Color"
                      Icon="{ui:SymbolIcon TargetArrow24}"
                      ToolTip="Inspect screen to capture cursor coordinates and hex color"
                    />
                  </WrapPanel>

                  <Border
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Padding="8,5"
                    Background="#0AFFFFFF"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="1"
                    CornerRadius="6"
                  >
                    <WrapPanel VerticalAlignment="Center">
                      <StackPanel
                        Margin="2,0,10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                      >
                        <ui:SymbolIcon
                          Margin="0,0,5,0"
                          FontSize="12"
                          Foreground="#80FFFFFF"
                          Symbol="Add24"
                        />
                        <TextBlock
                          VerticalAlignment="Center"
                          FontSize="11"
                          FontWeight="SemiBold"
                          Foreground="#80FFFFFF"
                          Text="SNIPPETS:"
                        />
                      </StackPanel>

                      <ui:Button
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="8,0"
                        Appearance="Secondary"
                        Click="InsertWaitSnippet_Click"
                        Content="+ Wait"
                        FontSize="12"
                        Icon="{ui:SymbolIcon Timer24}"
                        ToolTip="Insert sleep instruction (e.g. sleep 100ms)"
                      />

                      <ui:Button
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="8,0"
                        Appearance="Secondary"
                        Click="InsertKeySnippet_Click"
                        Content="+ Key"
                        FontSize="12"
                        Icon="{ui:SymbolIcon Keyboard24}"
                        ToolTip="Insert key press instruction (e.g. press &quot;1&quot; for 25ms)"
                      />

                      <ui:Button
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="8,0"
                        Appearance="Secondary"
                        Click="InsertClickSnippet_Click"
                        Content="+ Click"
                        FontSize="12"
                        Icon="{ui:SymbolIcon Cursor24}"
                        ToolTip="Insert mouse click instruction (e.g. click left at (500, 500))"
                      />

                      <ui:Button
                        Height="28"
                        Margin="0,0,5,0"
                        Padding="8,0"
                        Appearance="Secondary"
                        Click="InsertPixelSnippet_Click"
                        Content="+ Pixel"
                        FontSize="12"
                        Icon="{ui:SymbolIcon Eye24}"
                        ToolTip="Insert pixel check condition block"
                      />
                    </WrapPanel>
                  </Border>
                </Grid>
              </Border>

              <Border
                Grid.Row="1"
                Background="#181818"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                CornerRadius="4"
              >
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBox
                    x:Name="TxtLineNumbers"
                    Grid.Column="0"
                    MinWidth="36"
                    Padding="6,6,6,6"
                    Background="#121212"
                    BorderBrush="#25FFFFFF"
                    BorderThickness="0,0,1,0"
                    Focusable="False"
                    FontFamily="Consolas, Cascadia Code, Courier New"
                    FontSize="13"
                    Foreground="#60FFFFFF"
                    IsReadOnly="True"
                    TextAlignment="Right"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Hidden"
                  />

                  <TextBox
                    x:Name="TxtScriptCode"
                    Grid.Column="1"
                    Padding="6,6,6,6"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas, Cascadia Code, Courier New"
                    FontSize="13"
                    HorizontalScrollBarVisibility="Auto"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto"
                  />
                </Grid>
              </Border>

              <TextBlock
                x:Name="TxtDiagnosticStatus"
                Grid.Row="2"
                Margin="4,6,0,0"
                FontSize="12"
                FontWeight="Medium"
                Foreground="#00E676"
                Text="Ready"
              />
            </Grid>
          </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock FontSize="12" Foreground="#80FFFFFF" Text="Total Runs: " />
            <TextBlock
              x:Name="TxtRunCount"
              FontSize="12"
              FontWeight="Bold"
              Foreground="#40C4FF"
              Text="0"
            />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ui:Button
              x:Name="DocsMacroButton"
              Height="35"
              Margin="0,0,10,0"
              Padding="14,0"
              Appearance="Secondary"
              Click="DocsMacroButton_Click"
              Content="View Macro Docs"
              Icon="{ui:SymbolIcon DocumentCopy24}"
              ToolTip="Open AutoScript language documentation and macro guide"
            />
            <ui:Button
              x:Name="TestRunButton"
              Height="35"
              Margin="0,0,10,0"
              Padding="16,0"
              Appearance="Primary"
              Click="TestRunButton_Click"
              Content="Test Run"
              Icon="{ui:SymbolIcon Play24}"
              ToolTip="Test run macro immediately without game focus requirement"
            />
            <ui:Button
              x:Name="SaveButton"
              Height="35"
              Padding="20,0"
              Appearance="Secondary"
              Click="SaveButton_Click"
              Content="Save"
              Icon="{ui:SymbolIcon Save24}"
              ToolTip="Save macro changes and update hotkeys"
            />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
